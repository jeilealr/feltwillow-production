# generated files (renders, keyframes, audio, LoRAs, task files): never in git
work/
# media is ignored by default ...
*.mp4
*.mov
*.wav
*.png
*.jpg
# ... except the references the repo exists to keep:
!docs/img/*.jpg
!docs/img/*.png
# saved voice samples (voice/cast, voice/narrators)
!voice/**/*.wav
# character packs v2-v4 (identity authority) and the v4 record targets:
# references, expressions, scene start/end frames (interactions/v4/keyframes)
!character/characters/**/*.png
!character/characters/**/*.jpg
# location plates and props, one folder per story: character/locations/<story>/<place>/
!character/locations/**/*.png
!character/locations/**/*.jpg
# python
__pycache__/
*.pyc
.venv*/
# never commit weights, keys or binaries
*.safetensors
*.pkl
*.pt
*.pth
*.ckpt
*.bin
.env

# Gemini candidate takes (character/gemini_image.py); accepted ones are copied to the record target
character/**/gemini/

# Local image review outputs; ignore every .review folder in this repo and future projects
**/.review/

# Keep only the explicit v6 foundation review candidates trackable.
!character/characters/lion_and_mouse_v6/
!character/characters/lion_and_mouse_v6/**/
!character/characters/lion_and_mouse_v6/**/.review/
!character/characters/lion_and_mouse_v6/**/*.png
!character/locations/lion_and_mouse_v6/
!character/locations/lion_and_mouse_v6/**/
!character/locations/lion_and_mouse_v6/**/.review/
!character/locations/lion_and_mouse_v6/**/*.png

# Blender feasibility prototype: retain only small intentional review renders.
*.blend1
*.blend2
*.blend@
blender/**/cache/
blender/**/autosave/
blender/renders/intermediate/
!blender/renders/reference/**/*.png
!blender/renders/diagnostic/**/*.png

# Small reusable v7 paired sources/candidates and review evidence are intentional.
!stories/lion_and_mouse_v7/candidates/**/*.png
!stories/lion_and_mouse_v7/sources/**/*.png
!stories/lion_and_mouse_v7/review/paired/**/*.png

# Full narration recordings are backed up as versioned audio, not Git voice samples.
voice/narration/**/*.wav

# V7 compact visual-review/calibration evidence referenced by reports and tests.
!stories/lion_and_mouse_v7/review/**/*.jpg
